# ---------------------------------------------------------------------------
# Firebase Web app config  (Firebase console > Project settings > Your apps)
# These values are public by design; they are shipped in every client bundle.
# ---------------------------------------------------------------------------
EXPO_PUBLIC_FIREBASE_API_KEY=
EXPO_PUBLIC_FIREBASE_AUTH_DOMAIN=your-project.firebaseapp.com
EXPO_PUBLIC_FIREBASE_PROJECT_ID=your-project
EXPO_PUBLIC_FIREBASE_STORAGE_BUCKET=your-project.firebasestorage.app
EXPO_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
EXPO_PUBLIC_FIREBASE_APP_ID=

# ---------------------------------------------------------------------------
# The ONLY email domain allowed into the app (without the @).
# ---------------------------------------------------------------------------
EXPO_PUBLIC_ALLOWED_EMAIL_DOMAIN=hbplus.fit

# Comma separated list of emails that receive the "admin" role.
EXPO_PUBLIC_ADMIN_EMAILS=admin@hbplus.fit

# ---------------------------------------------------------------------------
# Google OAuth client IDs
# Web client ID:  Google Cloud console > Credentials > OAuth client ID > Web application
#                 (this is also shown inside Firebase > Authentication > Google > Web SDK configuration)
# iOS client ID:  OAuth client ID of type "iOS" (needed for native iOS builds)
# Note: google-signin v17 uses the Web client ID on Android too; register the
#       app's SHA-1 fingerprint on the Web OAuth client in Google Cloud.
# iOS URL scheme: the "iOS URL scheme" / reversed client ID from GoogleService-Info.plist
#                 e.g. com.googleusercontent.apps.123456-abcdefg
# ---------------------------------------------------------------------------
EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=
EXPO_PUBLIC_GOOGLE_IOS_CLIENT_ID=
EXPO_PUBLIC_GOOGLE_IOS_URL_SCHEME=
