rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    // The same rule is applied server-side: a Google token for any other
    // domain cannot read or write application data, even if client code is
    // modified or bypassed.
    function signedInWithAllowedDomain() {
      return request.auth != null
        && request.auth.token.email is string
        && request.auth.token.email.matches('.*@hbplus\\.fit$');
    }

    function isAdmin() {
      return signedInWithAllowedDomain()
        && (
          (request.auth.token.keys().hasAll(['admin']) && request.auth.token.admin == true)
          || (exists(/databases/$(database)/documents/users/$(request.auth.uid))
              && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin')
        );
    }

    match /users/{uid} {
      // Users can read their own profile; Admins can read all profiles for user management
      allow read: if signedInWithAllowedDomain()
        && (request.auth.uid == uid || isAdmin());

      allow create: if signedInWithAllowedDomain()
        && request.auth.uid == uid
        && request.resource.data.uid == uid
        && request.resource.data.email == request.auth.token.email
        // A client can never create itself as an admin. Promotion is a
        // separate update performed by an existing admin or a custom claim.
        && request.resource.data.role == 'user';

      // A user can refresh harmless profile fields, but never promote their
      // own role or change identity fields. Admins can update roles.
      allow update: if signedInWithAllowedDomain()
        && (
          (request.auth.uid == uid
            && request.resource.data.role == resource.data.role
            && request.resource.data.uid == resource.data.uid
            && request.resource.data.email == resource.data.email)
          || isAdmin()
        );

      allow delete: if isAdmin();
    }

    // Everything else is closed by default.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}

